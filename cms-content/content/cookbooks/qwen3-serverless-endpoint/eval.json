{
  "$schema": "../../../schemas/prompt-eval.schema.json",
  "schema_version": "1.0.0",
  "enabled": false,
  "agent": {
    "runner": "codex",
    "model": "gpt-5.6-terra",
    "cli_version": "0.149.1",
    "api_key_env": "OPENAI_API_KEY",
    "timeout_seconds": 900
  },
  "execution": null,
  "target": null,
  "thresholds": null,
  "checks": [
    {"id": "readme", "type": "path_exists", "path": "README.md", "kind": "file"},
    {"id": "verifier", "type": "path_exists", "path": "scripts/verify.py", "kind": "file"},
    {"id": "cleanup", "type": "path_exists", "path": "scripts/cleanup.sh", "kind": "file"},
    {"id": "tests", "type": "path_exists", "path": "tests", "kind": "directory"},
    {
      "id": "deployment-contract",
      "type": "text",
      "path": "README.md",
      "contains": ["Qwen/Qwen3-0.6B", "vllm/vllm-openai:v0.19.1", "gpu-l40s-a", "BASE_URL", "ENDPOINT_ID"],
      "not_contains": ["sk-", "TODO", "TBD"]
    },
    {"id": "local-checks", "type": "command", "argv": ["bash", "scripts/check.sh"], "timeout_seconds": 180}
  ]
}
